{
 "properties": {
  "connectionReferences": {
   "shared_sharepointonline": {
    "runtimeSource": "embedded",
    "connection": {
     "connectionReferenceLogicalName": "craf4_sharedsharepointonline_17d15"
    },
    "api": {
     "name": "shared_sharepointonline"
    }
   },
   "shared_office365": {
    "runtimeSource": "embedded",
    "connection": {
     "connectionReferenceLogicalName": "craf4_sharedoffice365_mdi"
    },
    "api": {
     "name": "shared_office365"
    }
   }
  },
  "definition": {
   "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
   "contentVersion": "1.0.0.0",
   "parameters": {
    "$connections": {
     "defaultValue": {},
     "type": "Object"
    },
    "$authentication": {
     "defaultValue": {},
     "type": "SecureObject"
    }
   },
   "triggers": {
    "When_a_People_row_changes": {
     "type": "OpenApiConnection",
     "recurrence": {
      "interval": 1,
      "frequency": "Minute"
     },
     "splitOn": "@triggerOutputs()?['body/value']",
     "inputs": {
      "host": {
       "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
       "connectionName": "shared_sharepointonline",
       "operationId": "GetOnUpdatedItems"
      },
      "parameters": {
       "dataset": "https://verxted.sharepoint.com/sites/MDISandbox",
       "table": "a4c78ec3-d9a8-4997-90cd-a4bb5a0e454d"
      },
      "authentication": "@parameters('$authentication')"
     }
    }
   },
   "actions": {
    "Has_email": {
     "type": "If",
     "runAfter": {},
     "expression": {
      "and": [
       {
        "not": {
         "equals": [
          "@trim(coalesce(triggerBody()?['Email'], ''))",
          ""
         ]
        }
       }
      ]
     },
     "actions": {
      "Login": {
       "type": "Compose",
       "runAfter": {},
       "inputs": "@concat('i:0#.f|membership|', toLower(trim(triggerBody()?['Email'])))"
      },
      "LoginEnc": {
       "type": "Compose",
       "runAfter": {
        "Login": [
         "Succeeded"
        ]
       },
       "inputs": "@encodeUriComponent(outputs('Login'))"
      },
      "Groups": {
       "type": "Compose",
       "runAfter": {
        "LoginEnc": [
         "Succeeded"
        ]
       },
       "inputs": "@createArray(addProperty(json('{\"name\":\"Members\",\"path\":\"AssociatedMemberGroup\"}'), 'want', equals(triggerBody()?['Active'], true)),addProperty(json('{\"name\":\"Config editors\",\"path\":\"sitegroups/getbyname(''MDI%20Config%20Editors'')\"}'), 'want', and(equals(triggerBody()?['Active'], true), or(equals(triggerBody()?['CanEditConfig'], true), equals(triggerBody()?['MDIAdmin'], true)))),addProperty(json('{\"name\":\"Owners\",\"path\":\"AssociatedOwnerGroup\"}'), 'want', and(equals(triggerBody()?['Active'], true), equals(triggerBody()?['MDIAdmin'], true))))"
      },
      "Each_group": {
       "type": "Foreach",
       "foreach": "@outputs('Groups')",
       "runtimeConfiguration": {
        "concurrency": {
         "repetitions": 1
        }
       },
       "runAfter": {
        "Groups": [
         "Succeeded"
        ]
       },
       "actions": {
        "Check_membership": {
         "runAfter": {},
         "type": "OpenApiConnection",
         "inputs": {
          "host": {
           "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
           "connectionName": "shared_sharepointonline",
           "operationId": "HttpRequest"
          },
          "parameters": {
           "dataset": "https://verxted.sharepoint.com/sites/MDISandbox",
           "parameters/method": "GET",
           "parameters/uri": "_api/web/@{items('Each_group')?['path']}/users?$select=Id&$filter=LoginName eq '@{outputs('LoginEnc')}'",
           "parameters/headers": {
            "Accept": "application/json;odata=nometadata",
            "Content-Type": "application/json;odata=nometadata"
           }
          },
          "authentication": "@parameters('$authentication')"
         }
        },
        "Is_member": {
         "type": "Compose",
         "runAfter": {
          "Check_membership": [
           "Succeeded"
          ]
         },
         "inputs": "@greater(length(coalesce(body('Check_membership')?['value'], createArray())), 0)"
        },
        "Add_if_needed": {
         "type": "If",
         "runAfter": {
          "Is_member": [
           "Succeeded"
          ]
         },
         "expression": {
          "and": [
           {
            "equals": [
             "@items('Each_group')?['want']",
             true
            ]
           },
           {
            "equals": [
             "@outputs('Is_member')",
             false
            ]
           }
          ]
         },
         "actions": {
          "Ensure_user": {
           "runAfter": {},
           "type": "OpenApiConnection",
           "inputs": {
            "host": {
             "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
             "connectionName": "shared_sharepointonline",
             "operationId": "HttpRequest"
            },
            "parameters": {
             "dataset": "https://verxted.sharepoint.com/sites/MDISandbox",
             "parameters/method": "POST",
             "parameters/uri": "_api/web/ensureuser",
             "parameters/headers": {
              "Accept": "application/json;odata=nometadata",
              "Content-Type": "application/json;odata=nometadata"
             },
             "parameters/body": "{\"logonName\":\"@{outputs('Login')}\"}"
            },
            "authentication": "@parameters('$authentication')"
           }
          },
          "Add_to_group": {
           "runAfter": {
            "Ensure_user": [
             "Succeeded"
            ]
           },
           "type": "OpenApiConnection",
           "inputs": {
            "host": {
             "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
             "connectionName": "shared_sharepointonline",
             "operationId": "HttpRequest"
            },
            "parameters": {
             "dataset": "https://verxted.sharepoint.com/sites/MDISandbox",
             "parameters/method": "POST",
             "parameters/uri": "_api/web/@{items('Each_group')?['path']}/users",
             "parameters/headers": {
              "Accept": "application/json;odata=nometadata",
              "Content-Type": "application/json;odata=nometadata"
             },
             "parameters/body": "{\"LoginName\":\"@{outputs('Login')}\"}"
            },
            "authentication": "@parameters('$authentication')"
           }
          }
         },
         "else": {
          "actions": {}
         }
        },
        "Remove_if_needed": {
         "type": "If",
         "runAfter": {
          "Add_if_needed": [
           "Succeeded"
          ]
         },
         "expression": {
          "and": [
           {
            "equals": [
             "@items('Each_group')?['want']",
             false
            ]
           },
           {
            "equals": [
             "@outputs('Is_member')",
             true
            ]
           }
          ]
         },
         "actions": {
          "Remove_from_group": {
           "runAfter": {},
           "type": "OpenApiConnection",
           "inputs": {
            "host": {
             "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
             "connectionName": "shared_sharepointonline",
             "operationId": "HttpRequest"
            },
            "parameters": {
             "dataset": "https://verxted.sharepoint.com/sites/MDISandbox",
             "parameters/method": "POST",
             "parameters/uri": "_api/web/@{items('Each_group')?['path']}/users/removeByLoginName(@v)?@v='@{outputs('LoginEnc')}'",
             "parameters/headers": {
              "Accept": "application/json;odata=nometadata",
              "Content-Type": "application/json;odata=nometadata"
             }
            },
            "authentication": "@parameters('$authentication')"
           }
          }
         },
         "else": {
          "actions": {}
         }
        }
       }
      }
     },
     "else": {
      "actions": {}
     }
    },
    "Catch": {
     "type": "Scope",
     "runAfter": {
      "Has_email": [
       "Failed",
       "TimedOut",
       "Skipped"
      ]
     },
     "actions": {
      "Catch_get_alert_email": {
       "runAfter": {},
       "type": "OpenApiConnection",
       "inputs": {
        "host": {
         "apiId": "/providers/Microsoft.PowerApps/apis/shared_sharepointonline",
         "connectionName": "shared_sharepointonline",
         "operationId": "GetItems"
        },
        "parameters": {
         "dataset": "https://verxted.sharepoint.com/sites/MDISandbox",
         "table": "1ce134d3-335f-415c-8ae0-e8cf7c0d9e16",
         "$filter": "Title eq 'Alert_Email'",
         "$top": 1
        },
        "authentication": "@parameters('$authentication')"
       }
      },
      "Catch_send_alert": {
       "runAfter": {
        "Catch_get_alert_email": [
         "Succeeded"
        ]
       },
       "type": "OpenApiConnection",
       "inputs": {
        "host": {
         "apiId": "/providers/Microsoft.PowerApps/apis/shared_office365",
         "connectionName": "shared_office365",
         "operationId": "SendEmailV2"
        },
        "parameters": {
         "emailMessage/To": "@{first(body('Catch_get_alert_email')?['value'])?['SettingValue']}",
         "emailMessage/Subject": "MDI flow FAILED: @{workflow()?['tags']?['flowDisplayName']}",
         "emailMessage/Body": "<p>An MDI flow failed and needs a look.</p><p><b>Flow:</b> @{workflow()?['tags']?['flowDisplayName']}<br><b>Run:</b> <a href=\"https://make.powerautomate.com/environments/@{workflow()?['tags']?['environmentName']}/flows/@{workflow()?['name']}/runs/@{workflow()?['run']?['name']}\">open the run history</a></p>",
         "emailMessage/Importance": "Normal"
        },
        "authentication": "@parameters('$authentication')"
       }
      }
     }
    }
   },
   "outputs": {}
  }
 },
 "schemaVersion": "1.0.0.0"
}